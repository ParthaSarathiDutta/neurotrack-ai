{
  "name": "neurotrack-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:ms1": "node scripts/validate-ms1.mjs",
    "validate:ms2": "node scripts/validate-ms2.mjs",
    "validate:tracking": "npx tsx scripts/validate-tracking.mjs",
    "validate:ms3": "node scripts/validate-ms3.mjs",
    "validate:ms4": "node scripts/validate-ms4.mjs",
    "validate:ms4-ghost": "node scripts/verify-preview-ghost-test50.mjs",
    "validate:ms5": "node scripts/validate-ms5.mjs",
    "validate:import-empty": "node scripts/validate-import-empty.mjs",
    "validate:ms6-viz": "node scripts/validate-ms6-viz.mjs",
    "generate:ms6-outputs": "npx tsx scripts/generate-ms6-outputs.ts",
    "validate:ms6-outputs": "node scripts/validate-ms6-outputs.mjs",
    "validate:ms6": "npm run validate:ms6-viz && npm run validate:ms6-outputs",
    "validate:deploy": "node scripts/validate-deploy.mjs",
    "validate:events-offline": "npx tsx scripts/validate-events-offline.mjs",
    "validate:calibration": "npx tsx scripts/validate-calibration.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "exceljs": "^4.4.0",
    "mp4box": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
